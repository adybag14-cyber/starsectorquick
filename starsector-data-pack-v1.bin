prite\":\"graphics/weapons/railgun_hardpoint_base.png\",\n\t\"hardpointGlowSprite\":\"graphics/weapons/railgun_hardpoint_glow.png\",\n\t\"glowColor\":[200,200,255,255],\n\t\"turretOffsets\":[10, 0],\n\t\"turretAngleOffsets\":[0],\n\t\"hardpointOffsets\":[15, 0],\n\t\"hardpointAngleOffsets\":[0],\n\t\"barrelMode\":\"ALTERNATING\", # or LINKED.  whether barrels fire at the same time or alternate.\n\t\"animationType\":\"GLOW\",\n\t\"autocharge\":true,  # whether the weapon will continue charging and fire if the LMB is tapped instead of held\n\t\"projectileSpecId\":\"railgun_shot\",  # projectile that will be fired\n\t\"fireSoundTwo\":\"railgun_fire\",\n}","data/weapons/realitydisruptor.wpn":"{\n\t\"id\":\"realitydisruptor\",\n\t\"specClass\":\"projectile\",\n\t\"everyFrameEffect\":\"com.fs.starfarer.api.impl.combat.RealityDisruptorEffect\",\n\t\"type\":\"ENERGY\",\n\t\"mountTypeOverride\":\"SYNERGY\",\n\t\"size\":\"LARGE\",\n\t\"turretSprite\":\"graphics/weapons/reality_disruptor_turret_base.png\",\n\t\"turretGlowSprite\":\"graphics/weapons/reality_disruptor_turret_glow.png\",\n\t\"hardpointSprite\":\"graphics/weapons/reality_disruptor_hardpoint_base.png\",\n\t\"hardpointGlowSprite\":\"graphics/weapons/reality_disruptor_hardpoint_glow.png\",\t\t\n\t\"hardpointOffsets\":[40, 0],\n\t\"turretOffsets\":[30, 0],\n\t\"hardpointAngleOffsets\":[0],\n\t\"turretAngleOffsets\":[0],\n\t\"unaffectedByProjectileSpeedBonuses\":true,\n\t\"glowColor\":[255,50,50,255], # used for emp arcs as well\n\t#\"glowColor\":[25,100,155,255],\n\t\"barrelMode\":\"ALTERNATING\",\n\t#\"renderHints\":[RENDER_LOADED_MISSILES],\n\t\"interruptibleBurst\":false,\n\t\"animationType\":\"GLOW\",\n\t\"autocharge\":true,\n\t\"projectileSpecId\":\"realitydisruptor_shot\",\n\t\"fireSoundTwo\":\"realitydisruptor_fire\",\n}\n\n\n","data/weapons/reaper.wpn":"{\n\t\"id\":\"reaper\",\n\t\"specClass\":\"projectile\",\n\t\"type\":\"MISSILE\",\n\t\"size\":\"SMALL\",\n\t\"turretSprite\":\"graphics/weapons/light_reaper_launcher_turret_base.png\",\n\t\"hardpointSprite\":\"graphics/weapons/light_reaper_launcher_hardpoint_base.png\",\n\t\"hardpointOffsets\":[10, 0],\n\t\"turretOffsets\":[7, 0],\n\t\"hardpointAngleOffsets\":[0],\n\t\"turretAngleOffsets\":[0],\n\t\"barrelMode\":\"ALTERNATING\",\n\t\"animationType\":\"SMOKE\",\n\t\"renderHints\":[RENDER_LOADED_MISSILES],\n\t\"interruptibleBurst\":false,\n\t\"displayArcRadius\":1000,\n\t\"smokeSpec\":{\"particleSizeMin\":16.0,\n\t\t\t\t \"particleSizeRange\":18.0,\n\t\t\t\t \"cloudParticleCount\":8,\n\t\t\t\t \"cloudDuration\":1.5,\n\t\t\t\t \"cloudRadius\":10.0,\n\t\t\t\t \"blowbackParticleCount\":4,\n\t\t\t\t \"blowbackDuration\":2.0,\n\t\t\t\t \"blowbackLength\":22.0,\n\t\t\t\t \"blowbackSpread\":15.0,\n\t\t\t\t \"particleColor\":[125,15,25,105]},\n\t\"projectileSpecId\":\"reaper_torp\",\n\t\"fireSoundTwo\":\"reaper_fire\",\n}\n\n\n","data/weapons/resonatormrm.wpn":"{\n\t\"id\":\"resonatormrm\",\n\t\"specClass\":\"projectile\",\n\t\"type\":\"MISSILE\",\n\t\"size\":\"MEDIUM\",\n\t\"turretSprite\":\"graphics/weapons/resonator_turret_base.png\",\n\t\"hardpointSprite\":\"graphics/weapons/resonator_hardpoint_base.png\",\n\t# glow sprites?\n\t#\"glowColor\":[235,255,215,255],\n\t\"hardpointOffsets\":[-1, 5.5, 10, 1.5, -1, -3.5, 10, -7.5],\n\t\"turretOffsets\":[-4, 5.5, 7, 1.5, -4, -3.5, 7, -7.5],\n\t\"hardpointAngleOffsets\":[0, 0, 0, 0],\n\t\"turretAngleOffsets\":[0, 0, 0, 0],\n\t\"renderHints\":[RENDER_LOADED_MISSILES],\n\t\"barrelMode\":\"ALTERNATING\",\n\t\"animationType\":\"NONE\",\n\t\"interruptibleBurst\":false,\n\t\"projectileSpecId\":\"resonatormrm_shot\",\n\t\"fireSoundTwo\":\"resonator_fire\",\n}","data/weapons/rift_lightning.wpn":"{\n\t\"id\":\"rift_lightning\",  # this id must match what's in the spreadsheet\n\t\"specClass\":\"projectile\",\n\t\"everyFrameEffect\":\"com.fs.starfarer.api.impl.combat.dweller.RiftLightningEffect\",\n\t\"type\":\"ENERGY\",\n\t\"size\":\"MEDIUM\",\n\t\"turretSprite\":\"graphics/weapons/rift_lightning_