assThroughMissiles\":true,\n\t\"passThroughFighters\":true,\n\t\"applyOnHitEffectWhenPassThrough\":false,\n\t\"engineSpec\":{\"turnAcc\":500,\n\t\t\t\t  \"turnRate\":100,\n\t\t\t\t  \"acc\":500,\n\t\t\t\t  \"dec\":500},\n\t\"engineSlots\":[{\"id\":\"ES1\",\n\t\t\t\t\t#\"loc\":[-7, 0],\n\t\t\t\t\t\"loc\":[0, 0],\n\t\t\t\t    \"style\":\"CUSTOM\",\n\t\t\t\t\t\"styleSpec\":{\n\t\t\t\t\t\t\"mode\":\"QUAD_STRIP\", # PARTICLES or QUAD_STRIP, determines which params are used\n\t\t\t\t\t\t\"engineColor\":[255,100,100,0],\n\t\t\t\t\t\t\"glowSizeMult\":2.5,\n\t\t\t\t\t\t\"glowAlternateColor\":[255,0,10,255],\n\t\t\t\t\t\t\"contrailDuration\":2,\n\t\t\t\t\t\t\"contrailWidthMult\":1.5,\n\t\t\t\t\t\t\"contrailWidthAddedFractionAtEnd\":1,  # can be negative. makes trail spread out/narrow at the end\n\t\t\t\t\t\t\"contrailMinSeg\":5, # min segment length, in pixels\n\t\t\t\t\t\t\"contrailMaxSpeedMult\":0f,\n\t\t\t\t\t\t\"contrailAngularVelocityMult\":0.5f,\n\t\t\t\t\t\t\"contrailSpawnDistMult\":0f, # how far away from engine it starts\n\t\t\t\t\t\t\"contrailColor\":[255,90,110,50],\n\t\t\t\t\t\t\"type\":\"GLOW\" # GLOW or SMOKE; additive or regular blend mode\n\t\t\t\t\t},\n\t\t\t\t    \"width\":10.0,\n\t\t\t\t    \"length\":50.0,\n\t\t\t\t    \"angle\":180.0}],\n}\n\t\t\t","data/weapons/proj/riftbeam_minelayer_mine.proj":"{\n\t\"id\":\"riftbeam_minelayer_mine\",\n\t\"specClass\":\"missile\",\t\n\t\"missileType\":\"PHASE_MINE\",\n\t\"sprite\":\"\",\n\t\"glowSprite\":\"\",\n\t\"glowColor\":[100,60,255,255], # also used for the NegativeExplosionVisual effect color\n\t\"size\":[96,96],\t\n\t\"center\":[48,48],\t\n\t\"collisionRadius\":20,\n\t\"collisionClass\":\"NONE\",\n\t\"collisionClassAfterFlameout\":\"NONE\",\n\t\"flameoutTime\":0.1, # total time from flameout to full fadeout\n\t\"fadeTime\":0.1, # fadeout duration\n\t\"noEngineGlowTime\":0.05, # time spent without the engine glow being rendered\n\t\"explosionColor\":[175,100,255,255],  # unused\n\t\"explosionRadius\":0, # purely visual\t\n\t\"renderTargetIndicator\":false, # no target diamond in combat view, not targeted by flares\n\t\"engineSpec\":{\"turnAcc\":500,\n\t\t\t\t  \"turnRate\":150,\n\t\t\t\t  \"acc\":500,\n\t\t\t\t  \"dec\":500},\n\t\"behaviorSpec\":{\"behavior\":\"PROXIMITY_FUSE\",\n\t\t\t\t\t\"onExplosionEffect\":\"com.fs.starfarer.api.impl.combat.RiftBeamMineExplosion\",\n\t\t\t\t\t\"range\":0,\n\t\t\t\t\t\"slowToMaxSpeed\":true,\n\t\t\t\t\t\"delay\":0,\n\t\t\t\t\t#\"pingSound\":\"launch_flare_1\",\n\t\t\t\t\t\"pingColor\":[100,60,255,255],\n\t\t\t\t\t\"mineHasNoSprite\":true,\n\t\t\t\t\t\"flashRateMult\":0.25,\n\t\t\t\t\t\"pingRadius\":100,\n\t\t\t\t\t\"pingDuration\":0.25,\n\t\t\t\t\t#\"windupSound\":\"mine_windup_heavy\",\n\t\t\t\t\t#\"windupDelay\":1,\n\t\t\t\t\t\"explosionSpec\":{\"duration\":0.1f,\n\t\t\t\t\t\t\t\t\t \"radius\":50,\n\t\t\t\t\t\t\t\t\t \"coreRadius\":35, # full damage within core radius\n\t\t\t\t\t\t\t\t\t \"collisionClass\":PROJECTILE_NO_FF,\n\t\t\t\t\t\t\t\t\t \"collisionClassByFighter\":PROJECTILE_NO_FF,\n\t\t\t\t\t\t\t\t\t \"particleDuration\":1,\n\t\t\t\t\t\t\t\t\t \"particleCount\":0,\n\t\t\t\t\t\t\t\t\t \"particleColor\":[0,0,0,0],\n\t\t\t\t\t\t\t\t\t \"explosionColor\":[0,0,0,0],\n\t\t\t\t\t\t\t\t\t \"sound\":\"riftbeam_rift\"},\n\t\t\t\t\t}\t\n}\n\n\n","data/weapons/proj/riftcascade_minelayer_mine.proj":"{\n\t\"id\":\"riftcascade_minelayer_mine\",\n\t\"specClass\":\"missile\",\t\n\t\"missileType\":\"PHASE_MINE\",\n\t\"sprite\":\"\",\n\t\"glowSprite\":\"\",\n\t#\"sprite\":\"graphics/missiles/heavy_mine3.png\",\n\t#\"glowSprite\":\"graphics/missiles/heavy_mine3_glow.png\",\n\t#\"glowColor\":[175,100,255,255], # also used for the NegativeExplosionVisual effect color\n\t\"glowColor\":[100,60,255,255], # also used for the NegativeExplosionVisual effect color\n\t#\"glowColor\":[255,100,100,255], # also used for the NegativeExplosionVisual effect color\n\t\"size\":[96,96],\t\n\t\"center\":[48,48],\t\n\t\"collisionRadius\":20,\n\t\"collisionClass\":\