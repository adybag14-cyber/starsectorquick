{

	##############################################################
	# These settings CAN NOT be changed by mods. 
	# You can still change them yourself, though.
	##############################################################
	
	"vsync":true,
	"fps":60,
	"devMode":false,
	"godMode":false, # 100x damage dealt, no damage taken
	"playtestingMode":false, # turns off some debug flags while in dev mode, doesn't do anything if not in dev mode.
	
	# if set to true, will print which rules are checked, which conditions pass/fail, etc
	# also likely to add a noticeable delay to when interaction options are selected
	# can also be toggled on/off in code via DebugFlags.PRINT_RULES_DEBUG_INFO
	"printRulesDebugInfo":false,
	
	"queryMaxAASamples":true,
	"maxAASamples":16, # selectable value is limited by this
	"aaSamplesOverride":-1, # >= 0 overrides value selected in launcher, required to use AA samples with legacyLauncher
	"screenScaleOverride":0, # > 0 overrides UI scaling value from in-game settings 
	"enableLauncherWarnings":true,
	
	
	# experimental feature, can cause problems such as invisible ships in combat and mouse-panning issues
	# but only on some PCs
	"allowJVMRestartFromLauncher":false,
	"allowJVMRestartFromLauncherInDevMode":false,
	
	# these only have any effect if allowJVMRestartFromLauncher is set to true
	"baseMemoryRequired":1024,
	"maxMemoryFractionOfTotal":0.5,
	"maxMemoryMB":6144,
	
	
	"doRAMandVRAMChecksWhenRunningWithMods":true, # will periodically check if ram/vram is low and warn the player
	"memoryCheckVerbose":false,
	"enableMemoryLeakChecking":true,
	"enableMemoryLeakCheckingDevModeOnly":true,
	
	"colorblindMode":false,
	"undecoratedWindow":false,
	"alwaysUndecoratedAtFullscreen":true,
	"enableSoundFilters":true,
	#"resolutionOverride":"1024x768",
	#"refreshRateOverride":60,
	#"forceAspectRatio":"1.3333",
	#"windowLocationX":0,
	#"windowLocationY":0,
	
	"showEnemyWaypoints":false,
	
	"allowForceQuitInIronMode":true, # whether Alt-F4 and similar works when playing campaign in iron mode
	
	"useDefaultMouseCursor":false,
	"useSoftwareMouseCursor":false, # can be useful if the mouse cursor is not showing for some reason
	
	"allowAnyJavaVersion":true,
	"requireTypingDeleteToDeleteSave":true,
	
	###
	##############################################################
	# These settings CAN be changed by mods
	##############################################################
	
	"localeOverride":"en_US",
	"cjkMode":false, # enables support for linewrapping for Chinese/Japanese/Korean fonts
	
	# VERY rudimentary accessibility feature
	# Writes some interaction text to saves/common/interaction_text
	# Slight performance impact as the disk writes happen on the main thread
	"writeInteractionTextToFile":false,
	
	"profilerEnabled":false,
	"forceNoVBO":true,
	"useGLFlush":true,
	"useGLFinish":false,
	"idleWhileWindowNotVisible":true,
	"doNotIdleWhenUndecoratedFullcreen":true, # idling in an undecorated fullscreen window can cause issues with alt-tabbing
	
	"legacyLauncher":false,
	"oneClickJumpPoints":false, # does not work do not set to true
	"altMouseMoveToMassTransfer":true,
	
	"allStandardShipsAndFactionsUnlockedInSimulator":false,
	"requireAICoresInCargoForSimulator":true,
	
	"allCodexEntriesUnlocked":false,
	"showLockedCodexEntries":true,
	
	# values above 2-3 will likely result in poor simulation fidelity
	"combatSpeedMult":1f,
	
	# integer, higher values speed up simulation with no loss of fidelity but at the cost of framerate
	# values greater than 1 also make it impossible to control the player ship correctly, this is
	# intended for AI vs AI battles only 
	"combatStepsPerFrame":1,
	
	
	"breakableShips":true,
	"renderDHullOverlay":true,
	"renderDHullOverlayForAllDebug":false,
	"dHullOverlayShadowOpacity":0.7f,
	"dHullOverlayMatchHullColor":true,
	"shipControlsTurnOffAutopilot":true,
	
	"convertedFighterBaysCanFastRelaunch":true,
	
	"impactSoundVolumeMult":0.8,
	
	"combatMapBorderPadForWaypoints":3000, # waypoints will be forced at least this far from the map border

	"uiFadeSpeedMult":1, # when set to 1000 or higher, also makes the hyperspace transition fade instant
	
	"showCNTranslationCredits":false,
	#"cnTranslationCreditsStringOverride":"",
	
	# no longer used due to saving/loading rendering happening on the main thread, bypassing the issue
	#"processMessagesWhileSavingOrLoading":true, # setting to false might work around graphics driver crashes while saving/loading game
	# adding out of an abundance of caution, *may* (but unlikely to) have same impact as above setting
	# setting to false will prevent save/load progress bar from rendering at all 
	"updateDisplayDuringSavingOrLoading":true,
	
	"fogOfWar":true,
	"fogOfWarColor":[70,92,114,0],   # alpha channel of this color is not used
	"smallClouds":true,  # set to true to improve nebula rendering performance
	# set to false to *maybe* work around driver issue re: fps drop when using Heron's system with shielded fighters
	"renderShieldJitterEffect":true,
	"compressSaveGameData":false, # smaller files, faster saving/loading, saveiles files not hand-editable
	
	"autosaveFeatureEnabled":true, # somewhat experimental, let's see how it goes
	"autosaveEnabledByDefault":true,
	"autosaveDefaultIntervalMinutes":30f,
	"autosaveExtraIntervalMinutesIfNotChangedLocation":[2f, 10f],
	"autosaveExtraIntervalMinutesIfNotChangedLocationFraction":0.5f,
	"maxAutosaveSlots":3,
	
	# disabled for now, causes issues with subsequent runs if game is shut down during startup
	"enableScriptCaching":false, # caches compiled scripts in saves/cache, faster startup time after first run

 	# when the game can't locate a ship variant for some reason (i.e. a bug or a mod mismatch) it will use this to not crash	
	"errorShipVariant":"nebula_Standard",
	
	"renderVersionAndIdle":true,
	"3dPlanetBGInInteractionDialog":false,
	"3dPlanetBackgrounds":true,
	"planetBGRightSide":true,
	"planetBGDimOverlayAlpha":0,
	
	"cloudColor":[255,255,255,255],
	# replaced with UI setting in the "Gameplay" Settings tab
	#"enableUIStaticNoise":true,
	"noiseColor":[40,152,176,255],
	"tripadLineColor":[158,241,240,255],
	"enableCampaignMapGridLines":true,
	#"enableShipExplosionWhiteout":false, # no longer used, replaced by checkbox in Gameplay Settings tab
	"useOldShipExplosions":false, # added for compatibility with GraphicsLib ship explosions
	"asteroidBeltMapColor":[70,50,40,255],
	"ringSystemMapColor":[100,130,145,255],
	"slipstreamUseGLLines":true, # a bit faster but may have some rendering issues depending on drivers
	
	"allowShipControlWhilePaused":true,
	"transferCommandCRCost":0,
	"reservesPeakTimeMult":0,
	
	"fluxPerCapacitor":200,
	"dissipationPerVent":10,
	
	"peakTimeWarningSeconds":30, # X seconds of peak time left when warning sound/message plays
	
	"maxLogisticsHullmods":2,
	"maxPermanentHullmods":2,
	
	# probability of AI core dropping from a destroyed enemy ship that had an AI core officer installed
	"drop_prob_officer_alpha_core":0.05,
	"drop_prob_officer_beta_core":0.1,
	"drop_prob_officer_gamma_core":0.2,
	"drop_prob_mult_ai_core_frigate":1,
	"drop_prob_mult_ai_core_destroyer":2,
	"drop_prob_mult_ai_core_cruiser":3,
	"drop_prob_mult_ai_core_capital":4,
	"drop_prob_mult_ai_core_station":1000, # the station always drops it
	
	# Shrouded Dweller substrate drops, can also do substrate_<hull_id> to override 
	"substrate_FRIGATE":[0.0, 0.03],
	"substrate_DESTROYER":[0.05, 0.1],
	"substrate_CRUISER":[0.5, 1.0],
	"substrate_CAPITAL_SHIP":[2, 4],
	"substrate_shrouded_maw":[3, 6],
	
	"maxArmorDamageReduction":0.85,
	"minArmorFraction":0.05, # effective armor never goes below max times this value, even when completely stripped
	"dpsToHitStrengthMult":0.5,
	"minRefireDelay":0.05,
	"zeroFluxEngineBoost":50,
	"minFluxVentFraction":0,
	"minVentTimeForWeaponReload":2,
	"minFighterReplacementRate":0.3,
	"friendlyCollisionDamageMult":0.5,
	
	"nebulaSpeedFighter":1,
	#"nebulaSpeedFrigate":0.7,
	#"nebulaSpeedDestroyer":0.8,
	#"nebulaSpeedCruiser":0.9,
	"nebulaSpeedFrigate":1,
	"nebulaSpeedDestroyer":1,
	"nebulaSpeedCruiser":1,
	"nebulaSpeedCapital":1,
	
	"crLossMultForRefit":1,
	"crLossMultForRefitWeapons":2,
	"crLossMultForRefitHullmods":4,
	
	"fighterCrewLossBase":0.5,
	
	# OpenAL-related
	"maxFXSources":128,
	"maxUISources":20,
	
	# how music is pushed back in the campaign while ambient/ability use sounds are happening
	#"campaignMusicVolumeMult":0.75,
	#"campaignMusicFilterGain":0.5,
	#"campaignMusicFilterGainHF":0.15,
	"campaignMusicVolumeMult":1,
	"campaignMusicFilterGain":1,
	"campaignMusicFilterGainHF":0.01,
	
	"campaignMaxPan":800,
	"campaignMaxObjectRangeAroundJumpPoint":5000,
	
	"factionsClaimUnpopulatedCoreSystems":true,
	
	"sectorWidth":164000,
	"sectorHeight":104000,
	#"sectorWidth":328000,
	#"sectorHeight":208000,
	
	"minNonCoreGatesInSector":15,
	"maxNonCoreGatesInSector":20,
	"minGatesToAddOnSecondPass":5, # at least this many gates added at farthest-from-any-other-gate systems
	"gateTransitFuelCostMult":0.5,
	
	"showCampaignRadar":true,
	"campaignRadarRadius":6000,
	
	# only used when devMode=false
	# should only be used by total conversions (vanilla is designed to look best within default zoom range)
	# the number is a multiplier for the viewport size
	"minCombatZoom":0.5, # zoomed in all the way
	"maxCombatZoom":2.0, # zoomed out all the way
	
	# only used when devMode=false
	"minCampaignZoom":0.5, # zoomed in all the way
	"maxCampaignZoom":3.0, # zoomed out all the way
	
	#
	# start difficulty config
	#
	"easyPlayerDamageDealtMult":1,
	"easyPlayerDamageTakenMult":0.75,
	"easySensorBonus":500,
	"easySalvageMult":1.5,
	"easyOfficerLevelMult":1,
	
	"enableSpacerStart":false,
	"enableStipend":true,
	
	#
	# end difficulty config
	#
	
	"genericRollingAverageFactor":0.9f, # per economy interval
	
	# for building industries and their income/upkeep
	"creditsPerCostUnit":1000,
	"industryBuildCostMult":5,
	"industryUpkeepMult":0.5,
	"industryIncomeMult":1,
	"exportIncomeMult":1,
	"industryRefundFraction":0.75,
	"minUpkeepMult":0.25,
	"upkeepReductionFromInFactionImports":0.5,
	"storageFreeFraction":0.01, # fraction of base value, per moth
	
	"maxIndustries":[1,1,1,2,3,4,4,4,4,4],
	"overMaxIndustriesPenalty":5, # stability penalty
	"maxColonySize":6, # maximum size to which a player colony can grow
	
	"rangeForMaxExoticDemand":10,
	"exoticUtilityMultAtMaxRange":2,
	
	"immigrationPerHazard":0.05,
	"immigrationHazardMultExtraPerColonySizeAbove3":0.5, # 0.5 means 50% more immigration penalty at size 4, 100% more at size 5
	"immigrationIncentiveCostPerPoint":1000,
	"immigrationIncentivePointsAboveHazardPenalty":5,
	
	"baseStabilizeCost":50000, # for a size-3 colony
	
	"allowRemoteIndustryItemManagement":false,
	
	"economyEnabled":true,
	"economyIntervalnGameDays":30, # not actually used by the economy, but used for a few other things
	
	"economyIterPerMonth":10,
	"economyMinDemandForPricing":100,
	"economyMinStockpileForPricing":100,	
	"economyNoDemandPriceMult":0.5,
	"economyGreedFraction":0.25,
	
	#"economyDeficitPriceIncrPerUnit":0.125,
	#"economyDeficitPriceMultMax":1.5,
	#"economyExcessPriceDecrPerUnit":0.11,
	#"economyExcessPriceMultMin":0.67,
	"economyDeficitPriceIncrPerUnit":0.25,
	"economyDeficitPriceMultMax":1.25,
	"economyExcessPriceDecrPerUnit":0.15,
	"economyExcessPriceMultMin":0.85,
	
	
	"stockpileMultProduction":0.25,
	"stockpileMultExcess":0.5,
	"stockpileMultImports":0,
	"stockpileMaxMonths":5,
	"stockpileCostMult":1,
	"stockpileShortageCostMult":0.1,
	
	
	"stabilityBaseValue":5,
	
	"accessibilityBaseValue":0.5, # used
	"accessibilityNoSpaceport":-1, # used
	"accessibilitySameFactionBonus":0.5,
	"accessibilityDistFromCOM":50, # accessibility will be base - 1 at that many light-years from center of mass
	"accessibilityPerUnitShipping":0.1,
	"accessibilityLossWhenAllHostile":1,
	

	#
	# end reach economy config
	#
		
	"economyExceptionOnMissingMarketEntity":true,
	
	# maybe unused
	"economyMaxPlayerSmugglingStabilityPenalty":5,
	"economyPlayerTradeImpactMult":1, # increases smuggling stability penalty and trade reputation changes
	"economyPlayerSellIllegalImpactMult":1,
	"economyPlayerSellMilitaryImpactMult":1,
	
	"economyPlayerTradeVolumeForRepChangeMin":100000,
	"economyPlayerTradeVolumeForRepChangeMax":1000000,
	"economyPlayerTradeVolumeForRepChangeIncr":100000,
	"economyPlayerXPPerCreditOfProfit":0.25,
	"economyMaxRangeForNegativeTradeRepImpactLY":0, # 0 = same system
	
	# how far off the average prices have to be to be highlighted red or green - UNUSED
	"profitMarginFlat":100, 
	"profitMarginMult":1.5,
	
	
	# start economy fleet spawning configuration
	"maxEconFleets":60,
	"minEconSpawnIntervalPerMarket":10, # no less than this many days between trade fleets from same market
	# end economy fleet spawning configuration
	
	#
	# end economy config	
	#
	
	"eventCheckInterval":30, # in days  mostly (or entirely?) not used anymore
	
	##### HOSTILE ACTIVITY EVENT CONFIG #####
	
	# BEGIN UNUSED
	# [min number of star systems, min fraction of star systems]
	"HA_1_affects":[1, 0.25],
	"HA_2_affects":[2, 0.5],
