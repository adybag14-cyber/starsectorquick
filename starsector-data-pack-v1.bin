//		boolean sMod = isSMod(ship);
//		if (sMod) {
//			float cap = (Float) mag.get(ship.getHullSize()); // * Misc.FLUX_PER_CAPACITOR;
//			
//			String id = "fca_sModEffect";
//			float capLevel = cap / Math.max(1f, ship.getMaxFlux());
//			if (capLevel < 0) {
