	"defaultChannels":[
		"news",
		"hegemony_public",
		"tritachyon_public",
		"player_intel_always",
		"local_comm",
		"secure_comm",
	],
	
	# messages sent on these channels will need to pass the same intel check as intercepts of comms
	# on other channels, but won't show an "intercepted by comm sniffer" note,
	# as conceptually they're an intel report based on data gleaned by comm sniffer,
	# rather than an actual intercept.
	"playerIntelChannels":[
		"player_intel",
	],
	
	"local_comm":{
		"name":"$sender",
		"logo":"graphics/icons/intel/comms64.png",
		"icon":"graphics/icons/intel/comms64.png",
		"image":"graphics/factions/player_flag.png",
		"sound":"ui_channel_comm_local",
		"type":"Local Comms",
		"shortType":"Comms",
	},
	"secure_comm":{
		"name":"$sender",
		"logo":"graphics/icons/intel/comms_secure64.png",
		"icon":"graphics/icons/intel/comms_secure64.png",
		"image":"graphics/factions/player_flag.png",
		"sound":"ui_channel_comm_secure",
		"type":"Secure Comm Channel",
		"shortType":"Comms",
	},
	"player_intel_always":{
		"name":"Analysis & Projections",
		"subChannelOf":"player_intel",
		"logo":"graphics/icons/intel/player.png",
		"icon":"graphics/icons/intel/player.png",
		"image":"graphics/factions/player_flag.png",
		"sound":"ui_channel_intel_assessment",
		"type":"Intelligence Assessment",
		"shortType":"Intel",
	},
	"player_intel":{
		"name":"Analysis & Projections",
		"logo":"graphics/icons/intel/player.png",
		"icon":"graphics/icons/intel/player.png",
		"image":"graphics/factions/player_flag.png",
		"sound":"ui_channel_intel_assessment",
		"type":"Intelligence Assessment",
		"shortType":"Intel",
	},
	"player_comm_sniffer":{
		"name":"Comm Sniffer Program",
		"logo":"graphics/icons/intel/player_comm_sniffer.png",
		"icon":"graphics/icons/intel/player_comm_sniffer.png",
		"image":"graphics/factions/player_flag.png",
		"sound":"ui_channel_sniffer",
		"type":"Comm Data Feed",
		"shortType":"Data",
	},
	"news":{
		"name":"Local Bulletin",
		"logo":"graphics/icons/intel/news64.png",
		"icon":"graphics/icons/intel/news64.png",
		"image":"graphics/factions/neutral_traders.png",
		"sound":"ui_channel_news",
		"type":"News Report",
		"shortType":"News",
	},
	"hegemony_public":{
		"name":"Hegemony Broadcast Service",
		"logo":"graphics/icons/intel/hegemony_public.png",
		"icon":"graphics/icons/intel/hegemony_public.png",
		"image":"graphics/factions/hegemony.png",
		"sound":"ui_channel_news",
		"faction":"hegemony",
		"type":"News Report",
		"shortType":"News",
	},
	"hegemony_internal":{
		"name":"Hegemony Intelligence",
		"logo":"graphics/icons/intel/hegemony_intelligence.png",
		"icon":"graphics/icons/intel/hegemony_intelligence.png",
		"image":"graphics/factions/hegemony.png",
		"sound":"ui_channel_comm_secure",
		"faction":"hegemony",
		"type":"Intelligence Report",
		"shortType":"Intel",
	},
	"tritachyon_public":{
		"name":"Tri-Tachyon Network",
		"logo":"graphics/icons/intel/tritachyon_public.png",
		"icon":"graphics/icons/intel/tritachyon_public.png",
		"image":"graphics/factions/tritachyon.png",
		"sound":"ui_channel_news",
		"faction":"tritachyon",
		"type":"News Report",
		"shortType":"News",
	},
	"tritachyon_internal":{
		"name":"Tri-Tachyon Intelligence",
		"logo":"graphics/icons/intel/tritachyon_internal.png",
		"icon":"graphics/icons/intel/tritachyon_internal.png",
		"image":"graphics/factions/tritachyon.png",
		"sound":"ui_channel_comm_secure",
		"faction":"tritachyon",
		"type":"Intelligence Report",
		"shortType":"Intel",
	},
	"sindrian_diktat_internal":{
		"name":"Sindrian Diktat Security",
		"logo":"graphics/icons/intel/diktat_intelligence.png",
		"icon":"graphics/icons/intel/diktat_intelligence.png",
		"image":"graphics/factions/sindrian_diktat.png",
		"sound":"ui_channel_comm_secure",
		"faction":"sindrian_diktat",
		"type":"Intelligence Report",
		"shortType":"Intel",
	},
}



