kes trail spread out/narrow at the end\n\t\t\t\t\t\t\"contrailMinSeg\":5, # min segment length, in pixels\n\t\t\t\t\t\t\"contrailMaxSpeedMult\":0.5f,\n\t\t\t\t\t\t\"contrailAngularVelocityMult\":0.5f,\n\t\t\t\t\t\t\"contrailColor\":[100,255,100,75],\n\t\t\t\t\t\t\"type\":\"SMOKE\" # GLOW or SMOKE; additive or regular blend mode\n\t\t\t\t\t},\n\t\t\t\t    \"width\":7.0,\n\t\t\t\t    \"length\":40.0,\n\t\t\t\t    \"angle\":180.0},\n\t\t\t\t    ]\n}","data/weapons/proj/hammer_torp.proj":"{\n\t\"id\":\"hammer_torp\",\n\t\"specClass\":\"missile\",\n\t\"missileType\":\"ROCKET\",\n\t\"sprite\":\"graphics/missiles/low_tech_torpedo.png\",\n\t\"size\":[10,22],\t\n\t\"center\":[5,11],\n\t\"collisionRadius\":15,\n\t\"collisionClass\":\"MISSILE_FF\",\n\t\"explosionColor\":[255,125,80,255],  # purely visual, will get a white additively blended core on top of this color\n\t\"explosionRadius\":230, # purely visual\n\t\"explosionSpec\":{\"duration\":0.1f, # not visual\n\t\t\t\t\t \"radius\":100,\n\t\t\t\t\t \"coreRadius\":65, # full damage within core radius\n\t\t\t\t\t \"collisionClass\":HITS_SHIPS_AND_ASTEROIDS,\n\t\t\t\t\t \"collisionClassByFighter\":HITS_SHIPS_AND_ASTEROIDS,\n\t\t\t\t\t \"particleSizeMin\":5.0,\n\t\t\t\t\t \"particleSizeRange\":3.0,\n\t\t\t\t\t \"particleDuration\":1,\n\t\t\t\t\t \"particleCount\":150,\n\t\t\t\t\t \"particleColor\":[255,165,135,255]},\n\t\"flameoutTime\":3, # total time from flameout to full fadeout\n\t\"armingTime\":.5,\n\t\"noEngineGlowTime\":0.5, # time spent without the engine glow being rendered\n\t\"fadeTime\":0.5, # fadeout duration\t\t\t\t\t \n\t\"engineSpec\":{\"turnAcc\":120,\n\t\t\t\t  \"turnRate\":30,\n\t\t\t\t  \"acc\":750,\n\t\t\t\t  \"dec\":200},\n\t\"engineSlots\":[{\"id\":\"ES1\",\n\t\t\t\t\t\"loc\":[-10, 0],\n\t\t\t\t    \"style\":\"CUSTOM\",\n\t\t\t\t\t\"styleSpec\":{\n\t\t\t\t\t\t\"mode\":\"QUAD_STRIP\", # PARTICLES or QUAD_STRIP, determines which params are used\n\t\t\t\t\t\t\"engineColor\":[225,100,70,255],\n\t\t\t\t\t\t\"g