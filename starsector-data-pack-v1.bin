eld\n\t\"projectileSpecId\":\"voltaic_discharge_shot\",  # projectile that will be fired\n\t\"fireSoundTwo\":\"voltaic_discharge_fire\",\n}","data/weapons/vortex_launcher.wpn":"{\n\t\"id\":\"vortex_launcher\",  # this id must match what's in the spreadsheet\n\t\"specClass\":\"projectile\",\n\t\"everyFrameEffect\":\"com.fs.starfarer.api.impl.combat.dweller.VortexLauncherEffect\",\n\t\"type\":\"MISSILE\",\n\t\"size\":\"LARGE\",\n\t\"turretSprite\":\"graphics/weapons/churning_locus.png\",\n\t#\"turretGlowSprite\":\"graphics/weapons/swarm_launcher_turret_glow.png\",\n\t\"hardpointSprite\":\"graphics/weapons/churning_locus.png\",\n\t#\"hardpointGlowSprite\":\"graphics/weapons/swarm_launcher_hardpoint_glow.png\",\n\t\"autocharge\":true,  # whether the weapon will continue charging and fire if the LMB is tapped instead of held\n\t\"glowColor\":[130,155,145,255],\n\t\"turretOffsets\":[18, 0],\n\t\"turretAngleOffsets\":[0],\n\t\"hardpointOffsets\":[12, 0],\n\t\"hardpointAngleOffsets\":[0],\n\t\"barrelMode\":\"ALTERNATING\", # or LINKED.  whether barrels fire at the same time or alternate.\n\t\"animationType\":\"GLOW\", #GLOW\n\t\"projectileSpecId\":\"vortex_launcher_shot\",  # projectile that will be fired\n\t\"fireSoundTwo\":\"shrouded_vortex_launch\",\n}","data/weapons/vpdriver.wpn":"{\n\t\"id\":\"vpdriver\",  # this id must match what's in the spreadsheet\n\t\"specClass\":\"projectile\",\n\t#\"everyFrameEffect\":\"com.fs.starfarer.api.impl.combat.VPDriverEffect\",\n\t\"type\":\"ENERGY\",\n\t\"mountTypeOverride\":\"HYBRID\",\n\t\"size\":\"LARGE\",\n\t\"turretSprite\":\"graphics/weapons/vp_turret_base.png\",\n\t\"turretGlowSprite\":\"graphics/weapons/vp_turret_glow.png\",\n\t\"hardpointSprite\":\"graphics/weapons/vp_hardpoint_base.png\",\n\t\"hardpointGlowSprite\":\"graphics/weapons/vp_hardpoint_glow.png\",\t\n\t\"turretOffsets\":[33, 0],\n\t\"turretAngleOffsets\":[0],\n\t\"hardpointOffsets\":[48, 0],\n\t\"hardpointAngleOffsets\":[0],\n\t\"barrelMode\":\"ALTERNATING\", # or LINKED.  whether barrels fire at the same time or alternate.\n\t#\"animationType\":\"GLOW\",\n\t\"animationType\":\"GLOW_AND_FLASH\",\n\t\"muzzleFlashSpec\":{\"length\":35.0,   # only used if animationType = MUZZLE_FLASH\n\t\t\t\t\t   \"spread\":0.0,\n\t\t\t\t\t   \"particleSizeMin\":12.0,\n\t\t\t\t\t   \"particleSizeRange\":12.0,\n\t\t\t\t\t   \"particleDuration\":0.12,\n\t\t\t\t\t   \"particleCount\":12,\n\t\t\t\t\t   \"particleColor\":[150,225,250,255]},\t\t\n\t\"glowColor\":[150,225,250,225],\n\t\"autocharge\":true,\n\t\"projectileSpecId\":\"vpdriver_shot\",  # projectile that will be fired\n\t\"fireSoundTwo\":\"vpdriver_fire\",\n}","data/weapons/vulcan.wpn":"{\n\t\"id\":\"vulcan\",  # this id must match what's in the spreadsheet\n\t\"specClass\":\"projectile\",\n\t\"type\":\"BALLISTIC\",\n\t\"size\":\"SMALL\",\n\t\"displayArcRadius\":250,\n\t\"turretSprite\":\"graphics/weapons/vulcan_cannon_turret_base.png\",\n\t\"turretGunSprite\":\"graphics/weapons/vulcan_cannon_turret_recoil.png\",\n\t\"hardpointSprite\":\"graphics/weapons/vulcan_cannon_hardpoint_base.png\",\n\t\"hardpointGunSprite\":\"graphics/weapons/vulcan_cannon_hardpoint_recoil.png\",\n\t\"renderHints\":[RENDER_BARREL_BELOW],\n\t\"visualRecoil\":3.0,  # the gun sprites are only used if this is non-0\n\t\"turretOffsets\":[10, -2, 10, 2],\n\t\"turretAngleOffsets\":[0, 0],\n\t\"hardpointOffsets\":[15, -2, 15, 2],\n\t\"hardpointAngleOffsets\":[0, 0],\n\t\"barrelMode\":\"ALTERNATING\", # or LINKED.  whether barrels fire at the same time or alternate.\n\t\"animationType\":\"MUZZLE_FLASH\",\n\t\"muzzleFlashSpec\":{\"length\":20.0,   # only used if animationType = MUZZLE_FLASH\n\t\t\t\t\t   \"spread\":6.0,\n\t\t\t\t\t   \"particleSizeMin\":6.0,\n\t\t\t\t\t   \"particleSizeRange\":8.0,\n\t\t\t\t\t   \"particleDuration\":0.15,\n\t\t\t\t\t   \"particleCount\":7,\n\t\t\t\t\t   \"particleColor\":[255,240,165,200]},\n\t\"projectileSpecId\":\"vulcan_shot\",  # projectile that will be fired\n\t#\"fireSoundOne\":\"vulc