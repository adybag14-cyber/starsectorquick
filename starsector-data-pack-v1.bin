\":[\"fourteenth\"],\n\t\"builtInWeapons\":{\n    },\n}","data/hulls/skins/gremlin_d_pirates.skin":"{\n\t\"baseHullId\":\"gremlin\",\n\t\"skinHullId\":\"gremlin_d_pirates\",\n\t\"hullName\":\"Gremlin (P)\",\n\t\"descriptionId\":\"gremlin\",\n\t\"descriptionPrefix\":\"This ship has been heavily modified - and poorly maintained - by its pirate crew.\",\n\t\"tags\":[\"pirate_bp\"],\n\t\"tech\":\"Pirate\",\n\t#\"ordnancePoints\":40,\n\t\"spriteName\":\"graphics/ships/phase/gremlin_pirates.png\",\n\t\"removeWeaponSlots\":[], \t\t# ids\n\t\"removeEngineSlots\":[], \t\t# indices, as engine slots have no id in the .ship file\n\t\"removeBuiltInMods\":[], \t\t# hullmod ids\n\t\"removeBuiltInWeapons\":[], \t\t# weapon slot ids\n\t#\"builtInMods\":[\"unstable_coils\",\"degraded_engines\",\"fragile_subsystems\"],\n\t\"builtInWeapons\":{\n    },\n}","data/hulls/skins/gremlin_luddic_path.skin":"{\n\t\"baseHullId\":\"gremlin\",\n\t\"skinHullId\":\"gremlin_luddic_path\",\n\t\"hullName\":\"Gremlin (LP)\",\n\t\"descriptionId\":\"gremlin\",\n\t\"descriptionPrefix\":\"Fanatics of the Luddic Path have made this ship their own, stripping out all unnecessary furnishing and transforming it into a haphazard vehicle of holy war.\",\n\t\"tags\":[\"LP_bp\"],\n\t\"tech\":\"Luddic Path\",\n\t\"baseValueMult\":.8,\n\t#\"ordnancePoints\":40,\n\t\"spriteName\":\"graphics/ships/phase/gremlin_pather.png\",\n\t\"removeWeaponSlots\":[], \t\t# ids\n\t\"removeEngineSlots\":[], \t\t# indices, as engine slots have no id in the .ship file\n\t\"removeBuiltInMods\":[], \t\t# hullmod ids\n\t\"removeBuiltInWeapons\":[], \t\t# weapon slot ids\n\t\"builtInMods\":[\"safetyoverrides\",\"ill_advised\"],\n\t\"builtInWeapons\":{\n    },\n}","data/hulls/skins/hammerhead_LG.skin":"{\n\t\"baseHullId\":\"hammerhead\",\n\t\"skinHullId\":\"hammerhead_LG\",\n\t\"hullName\":\"Hammerhead (LG)\",\n\t\"descriptionPrefix\":\"Modified for operations in the Askonia system under orders from Supreme Executor Philip Andrada, this hull 