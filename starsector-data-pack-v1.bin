\t\"glowColor\":[150,225,250,50],\n\t\"glowRadius\":1,\n\t\"hitGlowRadius\":30,\t\n\t\"textureScrollSpeed\":64.0,\n\t\"pixelsPerTexel\":5.0,\n\t#\"bulletSprite\":\"graphics/missiles/shell_gauss_cannon.png\",\n\t\"bulletSprite\":\"graphics/missiles/flechette_sml.png\",\n\t\n\t\"behaviorSpec\":{\"behavior\":\"PROXIMITY_FUSE\",\n\t\t\t\t\t\"shotRangeVariance\":0.5,\n\t\t\t\t\t\"probOfVariance\":0.5,\n\t\t\t\t\t\"range\":0,\n\t\t\t\t\t\"explosionSpec\":{\"duration\":0.12f,\n\t\t\t\t\t\t\t\t\t \"radius\":15,\n\t\t\t\t\t\t\t\t\t \"coreRadius\":0, # full damage within core radius - also equal to proximity fuse range\n\t\t\t\t\t\t\t\t\t \"collisionClass\":NONE,\n\t\t\t\t\t\t\t\t\t \"collisionClassByFighter\":NONE,\n\t\t\t\t\t\t\t\t\t \"particleSizeMin\":3.0,\n\t\t\t\t\t\t\t\t\t \"particleSizeRange\":2.0,\n\t\t\t\t\t\t\t\t\t \"particleDuration\":2,\n\t\t\t\t\t\t\t\t\t \"particleCount\":11,\n\t\t\t\t\t\t\t\t\t \"particleColor\":[150,225,250,255],\n\t\t\t\t\t\t\t\t\t \"explosionColor\":[150,225,250,125],\n\t\t\t\t\t\t\t\t\t \"sound\":\"vpdriver_explode_before_max_range\"\n\t\t\t\t\t\t\t\t\t },\t\n\t},\n}","data/weapons/proj/vulcan_shot.proj":"{\n\t\"id\":\"vulcan_shot\",\n\t\"specClass\":\"projectile\",\n\t\"spawnType\":\"BALLISTIC_AS_BEAM\",\n\t\"collisionClass\":\"RAY\",\n\t\"collisionClassByFighter\":\"RAY_FIGHTER\",\n\t\"hitGlowRadius\":15,\n\t#\"spawnType\":\"BALLISTIC\",\n\t#\"collisionClass\":\"PROJECTILE_FF\",\n\t#\"collisionClassByFighter\":\"PROJECTILE_FIGHTER\",\n\t\"length\":30.0,\n\t\"width\":3.5,\n\t\"fadeTime\":0.3,\n\t\"fringeColor\":[240,220,180,200],\n\t\"coreColor\":[245,245,225,80],\n\t\"textureScrollSpeed\":64.0,\n\t\"pixelsPerTexel\":5.0,\n\t\"bulletSprite\":\"graphics/missiles/shell_small_yellow.png\"\n}","data/weapons/pseudoparticle_jet.wpn":"{\n\t\"id\":\"pseudoparticle_jet\",  # this id must match what's in the spreadsheet\n\t\"specClass\":\"projectile\",\n\t\"type\":\"ENERGY\",\n\t\"mountTypeOverride\":\"HYBRID\",\n\t\"size\":\"MEDIUM\",\n\t\"everyFrameEffect\":\"com.fs.starfarer.api.impl.combat.dweller.PseudoparticleJetEffect\",\n\t\"turretSprite\":\"graphics/weapons/pseudoparticle_turret_base.png\",\n\t\"turretGlowSprite\":\"graphics/weapons/pseudoparticle_turret_glow.png\",\n\t\"hardpointSprite\":\"graphics/weapons/pseudoparticle_hardpoint_base.png\",\n\t\"hardpointGlowSprite\":\"graphics/weapons/pseudoparticle_hardpoint_glow.png\",\n\t\"glowColor\":[255,10,50,255],\n\t\"turretOffsets\":[6, 0], #15\n\t\"turretAngleOffsets\":[0],\n\t\"hardpointOffsets\":[8, 0],#15\n\t\"hardpointAngleOffsets\":[0],\n\t\"barrelMode\":\"ALTERNATING\", # or LINKED.  whether barrels fire at the same time or alternate.\n\t\"unaffectedByProjectileSpeedBonuses\":true,\n\t#\"animationType\":\"GLOW\",\n\t\"animationType\":\"GLOW_AND_FLASH\",\n\t\"muzzleFlashSpec\":{\"length\":12.0,   # only used if animationType = MUZZLE_FLASH or GLOW_AND_FLASH\n\t\t\t\t\t   \"spread\":4.0,\n\t\t\t\t\t   \"particleSizeMin\":8.0,\n\t\t\t\t\t   \"particleSizeRange\":5.0,\n\t\t\t\t\t   \"particleDuration\":0.3,\n\t\t\t\t\t   \"particleCount\":8,\n\t\t\t\t\t   \"particleColor\":[250,10,45,255]},\n\t\"autocharge\":true,  # whether the weapon will continue charging and fire if the LMB is tapped instead of held\n\t\"projectileSpecId\":\"pseudoparticle_jet_shot\",  # projectile that will be fired\n\t\"noImpactSounds\":true,\n}","data/weapons/pulselaser.wpn":"{\n\t\"id\":\"pulselaser\",  # this id must match what's in the spreadsheet\n\t\"specClass\":\"projectile\",\n\t\"type\":\"ENERGY\",\n\t\"size\":\"MEDIUM\",\n\t\"turretSprite\":\"graphics/weapons/pulse_laser_turret_base.png\",\n\t\"turretGlowSprite\":\"graphics/weapons/pulse_laser_turret_glow.png\",\n\t\"hardpointSprite\":\"graphics/weapons/pulse_laser_hardpoint_base.png\",\n\t\"hardpointGlowSprite\":\"graphics/weapons/pulse_laser_hardpoint_glow.png\",\n\t\"glowColor\":[100,255,100,255],\n\t\"turretOffsets\":[15, 0],\n\t\"turretAngleOffsets\":[0],\n\t\"hardpointOffsets\":[15, 0],\n\t\"hardpointAngleOffsets\":[0],\n\t\"barrelMode\":\"ALTERNATING\", # or LINKED.  whether barrels fire at the same time or alternate.\n\t#\"animationType\":\"GLOW\",\n\t\"animationType\":\"GLOW_AND_FLASH\",\n\t\"muzzleFlashSpec\":{\"length\":30.0,   # only used if animationType = MUZZLE_FLASH\n\t\t\t\t\t   \"spread\":5.0,\n\t\t\t\t\t   \"particleSizeMin\":15.0,\n\t\t\t\t\t   \"particleSizeRange\":20.0,\n\t\t\t\t\t   \"particleDuration\":0.12,\n\t\t\t\t\t   \"particleCount\":10,\n\t\t\t\t\t   \"particleColor\":[100,255,100,255]},\n\t\"autocharge\":true,  # whether the weapon will continue charging and fire if the LMB is tapped instead of held\n\t\"projectileSpecId\":\"pulselaser_shot\",  # projectile that will be fired\n\t\"fireSoundTwo\":\"pulse_laser_fire\",\n}","data/weapons/pusherplate_lt.wpn":"{\n\t\"specClass\":\"beam\",\n\t\"id\":\"pusherplate_lt\",\n\t\"type\":\"DECORATIVE\",\n\t\"size\":\"LARGE\",\n\t\"showDamageWhenDecorative\":true,\n\t\"renderBelowAllWeapons\":true,\n\t\n\t\"turretSprite\":\"graphics/weapons/decorative/pusher_plate_large.png\",\n\t\"turretGlowSprite\":\"graphics/weapons/hil_turret_glow.png\",\n\t\"hardpointSprite\":\"graphics/weapons/hil_hardpoint_base.png\",\n\t\"hardpointGlowSprite\":\"graphics/weapons/hil_hardpoint_glow.png\",\n\t\"turretOffsets\":[32, 0],\n\t\"turretAngleOffsets\":[0],\n\t\"hardpointOffsets\":[40, 0],\n\t\"hardpointAngleOffsets\":[0],\t\n\t\"fringeColor\":[25,75,155,255],\n\t\"coreColor\":[215,225,255,255],\n\t\"glowColor\":[40,90,255,235],\n\t\"darkCore\":false,\n\t\"width\":30.0,\n\t\"textureType\":ROUGH,\n\t\"textureScrollSpeed\":292.0,\n\t\"pixelsPerTexel\":5.0,\n\t\"pierceSet\":[PROJECTILE_FF,PROJECTILE_NO_FF,PROJECTILE_FIGHTER,MISSILE_FF,MISSILE_NO_FF],\n}","data/weapons/pusherplate_lt_small.wpn":"{\n\t\"specClass\":\"beam\",\n\t\"id\":\"pusherplate_lt_small\",\n\t\"type\":\"DECORATIVE\",\n\t\"size\":\"LARGE\",\n\t\"showDamageWhenDecorative\":true,\n\t\"renderBelowAllWeapons\":true,\n\t\n\t\"turretSprite\":\"graphics/weapons/decorative/