owSizeMult\":1.5,\n\t\t\t\t\t\t\"glowAlternateColor\":[150,100,255,255],\n\t\t\t\t\t\t\"contrailDuration\":2,\n\t\t\t\t\t\t\"contrailWidthMult\":1,\n\t\t\t\t\t\t\"contrailWidthAddedFractionAtEnd\":2,  # can be negative. makes trail spread out/narrow at the end\n\t\t\t\t\t\t\"contrailMinSeg\":5, # min segment length, in pixels\n\t\t\t\t\t\t\"contrailMaxSpeedMult\":.0f,\n\t\t\t\t\t\t\"contrailAngularVelocityMult\":0.5f,\n\t\t\t\t\t\t\"contrailSpawnDistMult\":.5, # how far away from engine it starts\n\t\t\t\t\t\t\"contrailColor\":[70,100,155,75],\n\t\t\t\t\t\t\"type\":\"GLOW\" # GLOW or SMOKE; additive or regular blend mode\n\t\t\t\t\t},\n\t\t\t\t    \"width\":10.0,\n\t\t\t\t    \"length\":50.0,\n\t\t\t\t    \"angle\":180.0}]\n}","data/weapons/proj/annihilator_rocket.proj":"{\n\t\"id\":\"annihilator_rocket\",\n\t\"specClass\":\"missile\",\n\t\"missileType\":\"ROCKET\",\n\t\"sprite\":\"graphics/missiles/missile_annihilator.png\",\n\t\"size\":[4,18],\t\n\t\"center\":[2,9],\n\t#\"size\":[10,21],\t\n\t#\"center\":[5,10.5],\n\t\"collisionRadius\":12,\n\t\"collisionClass\":\"MISSILE_FF\",\n\t\"explosionColor\":[255,165,0,255],  # purely visual, will get a white additively blended core on top of this color\n\t\"explosionRadius\":75, # purely visual\n\t\"flameoutTime\":1, # total time from flameout to full fadeout\n\t\"noEngineGlowTime\":0.5, # time spent without the engine glow being rendered\n\t\"fadeTime\":0.5, # fadeout duration\t\n\t\"engineSpec\":{\"turnAcc\":0,\n\t\t\t\t  \"turnRate\":0,\n\t\t\t\t  \"acc\":400,\n\t\t\t\t  \"dec\":0},\n\t\"engineSlots\":[{\"id\":\"ES1\",\n\t\t\t\t\t\"loc\":[-11, 0],\n\t\t\t\t    #\"style\":\"ROCKET_LOW_TECH\",\n\t\t\t\t    \"style\":\"CUSTOM\",\n\t\t\t\t\t\"styleSpec\":{\n\t\t\t\t\t\t\"mode\":\"QUAD_STRIP\", # PARTICLES or QUAD_STRIP, determines which params are used\n\t\t\t\t\t\t\"engineColor\":[255,125,25,255],\n\t\t\t\t\t\t\"contrailDuration\":.5,\n\t\t\t\t\t\t\"contrailWidthMult\":2,\n\t\t\t\t\t\t\"contrailWidthAddedFractionAtEnd\":2,  # can be negative. makes trail spread out/narrow at the end\n\t\t\t\t\t\t\"contrailMinSeg\":5, # min segment length, in pixels\n\t\t\t\t\t\t\"contrailMaxSpeedMult\":.0f,\n\t\t\t\t\t\t\"contrailAngularVelocityMult\":0.5f,\n\t\t\t\t\t\t\"contrailSpawnDistMult\":0f, # how far away from engine it starts\n\t\t\t\t\t\t\"contrailColor\":[75,75,75,150],\n\t\t\t\t\t\t\"type\":\"SMOKE\" # GLOW or SMOKE; additive or regular blend mode\n\t\t\t\t\t},\n\t\t\t\t    \"width\":4.0,\n\t\t\t\t    \"length\":30.0,\n\t\t\t\t    \"angle\":180.0}]\n}\n\n\t\t\t","data/weapons/proj/arbalest_shot.proj":"{\n\t\"id\":\"arbalest_shot\",\n\t\"specClass\":\"projectile\",\n\t\"spawnType\":\"BALLISTIC\",\n\t\"collisionClass\":\"PROJECTILE_FF\",\n\t\"collisionClassByFighter\":\"PROJECTILE_FIGHTER\",\n\t\"length\":30.0,\n\t\"width\":8.5,\n\t\"fadeTime\":0.20,\n\t#\"fringeColor\":[255,255,100,255],\n\t#\"coreColor\":[255,255,200,150],\n\t\"fringeColor\":[235,255,215,235],\n\t\"coreColor\":[225,255,205,200],\t\n\t\"textureScrollSpeed\":64.0,\n\t\"pixelsPerTexel\":5.0,\n\t\"bulletSprite\":\"graphics/missiles/shell_large_green.png\"\n}","data/weapons/proj/assaying_rift_proj.proj":"{\n\t\"id\":\"assaying_rift_proj\",\n\t\"specClass\":\"missile\",\n\t\"missileType\":\"MISSILE\",\n\t\"onHitEffect\":\"com.fs.starfarer.api.impl.combat.dweller.AssayingRiftEffect\",\n\t#\"onFireEffect\":\"com.fs.starfarer.api.impl.combat.dweller.AssayingRiftEffect\", # handled in everyframe in .wpn file\n\t\"sprite\":\"graphics/missiles/hungering_rift_projectile.png\",\n\t#\"sprite\":\"graphics/fx/empty.png\",\n\t\"size\":[12,12],\t\n\t\"center\":[6,6],\n\t\"collisionRadius\":10,\n\t\"collisionClass\":\"MISSILE_NO_FF\",\n\t\"explosionColor\":[255,30,50,255],  # purely visual, will get a white additively blended core on top of this color\n\t\"explosionRadius\":130, # purely visual\n\t#\"alwaysAccelerate\":true,\n\t#\"reduceDamageWhileFading\":true,\n\t\"noCollisionWhileFading\":true,\n\t\"useHitGlowWhenDealingDamage\":false, # using the scripted rift explosion instead\n\t\"useHitGlowWhenDestroyed\":true, # instead of the default explosion\n\t\"dudProbabilityOnFlameout\":0,\n\t\"fizzleOnReachingWeaponRange\":true,\t\t\t\t\t \n\t\"armingTime\":0,\n\t\"flameoutTime\":0.2, # total time from flameout to full fadeout\n\t\"noEngineGlowTime\":0.2, # time spent without the engine glow being rendered\n\t\"fadeTime\":0.2, # fadeout duration\t\t\t\n\t\"glowColor\":[255,20,50,100], #150\n\t\"glowRadius\":75,\n\t#\"passThroughMissiles\":true,\n\t#\"passThroughFighters\":true,\n\t#\"applyOnHitEffectWhenPassThrough\":false,\n\t\"engineSpec\":{\"turnAcc\":1000,\n\t\t\t\t  \"turnRate\":200,\n\t\t\t\t  \"acc\":100,\n\t\t\t\t  \"dec\":100},\n\t\"behaviorSpec\":{\"behavior\":\"PROXIMITY_FUSE\",\n\t\t\t\t\t#\"range\":40,\n\t\t\t\t\t\"range\":-10000,\n\t\t\t\t\t#\"vsMissileRange\":20,\n\t\t\t\t\t#\"vsFighterRange\":20,\n\t\t\t\t\t\"slowToMaxSpeed\":true,\n\t\t\t\t\t\"explosionSpec\":{\"duration\":0.1f, # not visual\n\t\t\t\t\t\t\t\t\t \"radius\":80,\n\t\t\t\t\t\t\t\t\t \"coreRadius\":30, # full damage within core radius\n\t\t\t\t\t\t\t\t\t \"collisionClass\":PROJECTILE_FF,\n\t\t\t\t\t\t\t\t\t \"collisionClassByFighter\":PROJECTILE_FIGHTER,\n\t\t\t\t\t\t\t\t\t \"particleSizeMin\":10.0,\n\t\t\t\t\t\t\t\t\t \"particleSizeRange\":5.0,\n\t\t\t\t\t\t\t\t\t \"particleDuration\":0.5,\n\t\t\t\t\t\t\t\t\t \"particleCount\":0,\n\t\t\t\t\t\t\t\t\t \"particleColor\":[255,20,50,255],\n\t\t\t\t\t\t\t\t\t #\"sound\":\"rifttorpedo_explosion\", # sound is played by script in onHit method\n\t\t\t\t\t\t\t\t\t },\t\t\t\t\t\n\t\t\t\t\t},\n\t\"engineSlots\":[{\"id\":\"ES1\",\n\t\t\t\t\t\"loc\":[0, 0],\n\t\t\t\t    \"style\":\"CUSTOM\",\n\t\t\t\t\t\"styleSpec\":{\n\t\t\t\t\t\t\"mode\":\"QUAD_STRIP\", # PARTICLES or QUAD_STRIP, determines which params are used\n\t\t\t\t\t\t\"engineColor\":[255,100,100,0],\n\t\t\t\t\t\t\"glowSizeMult\":1,\n\t\t\t\t\t\t\"glowAlternateColor\":[255,90,110,255],\n\t\t\t\t\t\t\"contrailDuration\":0,\n\t\t\