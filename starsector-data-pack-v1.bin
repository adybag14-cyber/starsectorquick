":2.0,\n\t\t\t\t \"blowbackLength\":30.0,\n\t\t\t\t \"blowbackSpread\":10.0,\n\t\t\t\t \"particleColor\":[100,100,100,0]},\n\t\"projectileSpecId\":\"terminator_missile_proj\",\n\t#\"fireSoundTwo\":\"harpoon_fire\",\n}","data/weapons/tpc.wpn":"{\n\t\"id\":\"tpc\",  # this id must match what's in the spreadsheet\n\t\"specClass\":\"projectile\",\n\t\"type\":\"ENERGY\",\n\t\"size\":\"LARGE\",\n\t\"turretSprite\":\"graphics/weapons/onslaught_thermal_turret_base.png\",\n\t\"turretGlowSprite\":\"\",\n\t\"hardpointSprite\":\"\",\n\t\"hardpointGlowSprite\":\"graphics/weapons/onslaught_thermal_glow.png\",\n\t\"turretOffsets\":[25, 0],\n\t\"turretAngleOffsets\":[0],\n\t\"hardpointOffsets\":[15, 0],\n\t\"hardpointAngleOffsets\":[0],\n\t\"barrelMode\":\"ALTERNATING\", # or LINKED.  whether barrels fire at the same time or alternate.\n\t\"animationType\":\"GLOW_AND_FLASH\",\n\t\"glowColor\":[255,100,100,255],\n\t\"muzzleFlashSpec\":{\"length\":30.0,\n\t\t\t\t\t   \"spread\":5.0,\n\t\t\t\t\t   \"particleSizeMin\":15.0,\n\t\t\t\t\t   \"particleSizeRange\":20.0,\n\t\t\t\t\t   \"particleDuration\":0.12,\n\t\t\t\t\t   \"particleCount\":10,\n\t\t\t\t\t   \"particleColor\":[255,100,100,255]},\t\t\n\t\"autocharge\":true,  # whether the weapon will continue charging and fire if the LMB is tapped instead of held\n\t\"projectileSpecId\":\"tpc_shot\",  # projectile that will be fired\n\t\"fireSoundTwo\":\"thermal_pulse_cannon_fire\",\n}","data/weapons/typhoon.wpn":"{\n\t\"id\":\"typhoon\",\n\t\"specClass\":\"projectile\",\n\t\"type\":\"MISSILE\",\n\t\"size\":\"MEDIUM\",\n\t\"turretSprite\":\"graphics/weapons/typhoon_reaper_launcher_turret_base.png\",\n\t\"hardpointSprite\":\"graphics/weapons/typhoon_reaper_launcher_hardpoint_base.png\",\n\t\"hardpointOffsets\":[20, 0],\n\t\"turretOffsets\":[20, 0],\n\t\"hardpointAngleOffsets\":[0],\n\t\"turretAngleOffsets\":[0],\n\t\"barrelMode\":\"LINKED\",\n\t\"animationType\":\"SMOKE\",\n\t#\"renderHints\":[RENDER_LOADED_MISSILES],\n\t\"interruptibleBurst\":false,\n\t\"displayArcRadius\":1000,\n\t\"smokeSpec\":{\"particleSizeMin\":10.0,\n\t\t\t\t \"particleSizeRange\":12.0,\n\t\t\t\t \"cloudParticleCount\":10,\n\t\t\t\t \"cloudDuration\":2.5,\n\t\t\t\t \"cloudRadius\":10.0,\n\t\t\t\t \"blowbackParticleCount\":8,\n\t\t\t\t \"blowbackDuration\":2.0,\n\t\t\t\t \"blowbackLength\":18.0,\n\t\t\t\t \"blowbackSpread\":10.0,\n\t\t\t\t \"particleColor\":[245, 65, 35,120]},\n\t\"projectileSpecId\":\"reaper_torp\",\n\t\"fireSoundTwo\":\"reaper_fire\",\n}","data/weapons/unstable_fragment.wpn":"{\n\t\"id\":\"unstable_fragment\",\n\t\"specClass\":\"projectile\",\n\t\"everyFrameEffect\":\"com.fs.starfarer.api.impl.combat.threat.UnstableFragmentMissileEffect\",\n\t\"type\":\"MISSILE\",\n\t\"size\":\"SMALL\",\n\t\"turretSprite\":\"graphics/weapons/unstable_fragment_turret_base.png\",\n\t\"turretGlowSprite\":\"graphics/weapons/unstable_fragment_turret_glow.png\",\n\t\"hardpointSprite\":\"graphics/weapons/unstable_fragment_hardpoint_base.png\",\n\t\"hardpointGlowSprite\":\"graphics/weapons/unstable_fragment_hardpoint_glow.png\",\n\t\"glowColor\":[255,80,80,255],\n\t\"autocharge\":true,  # whether the weapon will continue charging and fire if the LMB is tapped instead of held\n\t\"hardpointOffsets\":[0, 0],\n\t\"turretOffsets\":[0, 0],\n\t\"hardpointAngleOffsets\":[0],\n\t\"turretAngleOffsets\":[0],\n\t#\"renderHints\":[RENDER_LOADED_MISSILES],\n\t\n\t\"barrelMode\":\"ALTERNATING\",\n\t\"animationType\":\"GLOW\",\n\t\"interruptibleBurst\":false,\n\t\"projectileSpecId\":\"unstable_fragment_missile\",\n\t\"fireSoundTwo\":\"unstable_fragment_fire\",\n}","data/weapons/voidblaster.wpn":"{\n\t\"id\":\"voidblaster\",  # this id must match what's in the spreadsheet\n\t\"specClass\":\"projectile\",\n\t\"everyFrameEffect\":\"com.fs.starfarer.api.impl.combat.threat.VoidblasterEffect\",\n\t\"type\":\"ENERGY\",\n\t\"size\":\"MEDIUM\",\n\t\"turretSprite\":\"graphics/weapons/voidblaster_turret_base.png\",\n\t\"turretGunSprite\":\"graphics/weapons/voidblaster_turret_recoil.png\",\n\t\"hardpointSprite\":\"graphics/weapons/voidblaster_hardpoint_base.png\",\n\t\"hardpointGunSprite\":\"graphics/weapons/voidblaster_hardpoint_recoil.png\",\n\t\"turretGlowSprite\":\"graphics/weapons/voidblaster_turret_glow.png\",\n\t\"hardpointGlowSprite\":\"graphics/weapons/voidblaster_hardpoint_glow.png\",\n\t\"glowColor\":[120,110,185,255],\n\t\"visualRecoil\":3.0,  # the gun sprites are only used if this is non-0\n\t\"renderHints\":[RENDER_BARREL_BELOW],\n\t\"turretOffsets\":[22, 0],\n\t\"turretAngleOffsets\":[0],\n\t\"hardpointOffsets\":[22, 0],\n\t\"hardpointAngleOffsets\":[0],\n\t\"unaffectedByProjectileSpeedBonuses\":true,\n\t#\"noImpactSounds\":true,\n\t\"barrelMode\":\"ALTERNATING\", # or LINKED.  whether barrels fire at the same time or alternate.\n\t\"animationType\":\"GLOW_AND_FLASH\",  # NONE, GLOW, MUZZLE_FLASH, SMOKE\n\t\"muzzleFlashSpec\":{\"length\":40.0,   # only used if animationType = MUZZLE_FLASH\n\t\t\t\t\t   \"spread\":10.0,\n\t\t\t\t\t   \"particleSizeMin\":15.0,\n\t\t\t\t\t   \"particleSizeRange\":21.0,\n\t\t\t\t\t   \"particleDuration\":0.5,\n\t\t\t\t\t   \"particleCount\":15,\n\t\t\t\t\t  \"particleColor\":[120,110,185,235]},\n\t\"projectileSpecId\":\"voidblaster_shot\",  # projectile that will be fired\t\n\t\"fireSoundTwo\":\"voidblaster_fire\",\n\t\"stopPreviousFireSound\":true,\n}\n","data/weapons/voltaic_cannon.wpn":"{\n\t\"id\":\"voltaic_cannon\",  # this id must match what's in the spreadsheet\n\t\"specClass\":\"projectile\",\n\t\"everyFrameEffect\":\"com.fs.starfarer.api.impl.combat.threat.VoltaicCannonEffect\",\n\t\"type\":\"ENERGY\",\n\t\"size\":\"SMALL\",\n\t\"turretSprite\":\"graphics/weapons/voltaic_cannon_turret_base.png\",\n\t\"turretGlowSprite\":\"graphics/weapons/voltaic_cannon_turret_glow.png\",\n\t\"hardpointSprite\":\"graphics/weapons/voltaic_cannon_hardpoint_base.png\",\n\t\"hardpointGlowSprite\":\"graphics/weapons/voltaic_cannon_hardpoint_glow.png\",\n\t\"glowColor\":[130,155,145,255],\n\