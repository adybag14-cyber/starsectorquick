# Oracle Cloud Configuration
# Copy this file to .env and fill in your actual values
# DO NOT commit .env to GitHub - it contains sensitive information

# Instance Details
OCI_INSTANCE_IP=your-instance-public-ip
# Example: OCI_INSTANCE_IP=144.21.61.111

# API Key Configuration
OCI_API_KEY_PATH=path/to/your/api-key.pem
# Example: OCI_API_KEY_PATH=C:/Users/yourname/Downloads/your-email-2026-01-24T18_07_14.360Z.pem

OCI_FINGERPRINT=your-fingerprint
# Example: OCI_FINGERPRINT=c7:f8:31:c2:08:ee:3a:a7:77:23:40:a0:ae:79:92:bc

# Oracle Cloud Identifiers
OCI_TENANCY_OCID=ocid1.tenancy.oc1...
# Example: OCI_TENANCY_OCID=ocid1.tenancy.oc1..aaaaaaaan3fwo3yruzh7ucpbnlw4rhuytctzjh42gobfniscdda4cotv5lwq

OCI_USER_OCID=ocid1.user.oc1...
# Example: OCI_USER_OCID=ocid1.user.oc1..aaaaaaaao7jxegzihgw6llkjv7yrjqedjsph77isua7kancg5bqyk7fgsbnq

OCI_COMPARTMENT_OCID=ocid1.compartment.oc1...
# Example: OCI_COMPARTMENT_OCID=ocid1.compartment.oc1..aaaaaaaabbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb

OCI_REGION=your-region
# Available regions:
# - us-ashburn-1 (US East - Ashburn)
# - us-phoenix-1 (US West - Phoenix)
# - eu-frankfurt-1 (EU Central - Frankfurt)
# - eu-london-1 (UK South - London)
# - ap-tokyo-1 (Asia Pacific - Tokyo)
# - ap-sydney-1 (Asia Pacific - Sydney)
# Example: OCI_REGION=uk-london-1

# How to get these values:
# 1. Log in to Oracle Cloud Console: https://console.oraclecloud.com
# 2. Navigate to Identity & Security > Users
# 3. Click on your user name
# 4. Go to API Keys > Add API Key
# 5. Download the PEM file and note the fingerprint
# 6. Your Tenancy OCID is shown in the console header
# 7. Your User OCID is shown on your user profile page
# 8. Your Compartment OCID is shown in Identity & Security > Compartments
# 9. Your Instance IP is shown in Compute > Instances > Instance Details